<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <UserSecretsId>dotnet-XRUIOS.Linux.PublicAccountDataHandler-9e3a3c63-f98a-4ffe-ba55-f313906f7507</UserSecretsId>
  </PropertyGroup>

  <!-- The worker is a thin Eclipse-secured host. All transport + crypto + Notary
       verification lives in XRUIOS.Interfaces (SecureWorkerHost / NotaryGuard). -->
  <ItemGroup>
    <ProjectReference Include="..\XRUIOS.Interfaces\XRUIOS.Interfaces.csproj" />
    <ProjectReference Include="..\XRUIOS.Linux\XRUIOS.Linux.csproj" />
  </ItemGroup>

  <!-- Direct reference so the worker can use Eclipse's [SeaOfDirac] attribute at compile time
       (raw DLL references aren't transitive through a ProjectReference). -->
  <ItemGroup>
    <Reference Include="EclipseProject">
      <HintPath>..\libs\EclipseProject.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
